# Copy to .env (same folder as composer.json) and fill in. Never commit .env.

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bestitfriend
DB_USER=pnf_app
DB_PASSWORD=choose-a-strong-password
DB_SSLMODE=require

# Auth
JWT_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# This site's public base URL (no trailing slash) — used to build upload URLs.
APP_URL=https://yourdomain.com

# Leave as * only while testing; set to your real origin in production if the
# frontend is ever hosted on a different domain than this API.
CORS_ORIGIN=*

# M-Pesa (Daraja)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
